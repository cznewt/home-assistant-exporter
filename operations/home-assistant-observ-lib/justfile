# home-assistant-observ-lib dev tasks. Rendering is done by the observ-lib
# image: the observ-viz library is baked in on the jpath, so there's no
# jb/vendor and no grafonnet. Renders the mixin to Grafana dashboards +
# Prometheus alert and recording rules. Generic — promote to any observ-lib.

IMAGE := "ghcr.io/cznewt/observ-lib:latest"

# list targets
default:
    @just --list

# render the Grafana v2 dashboards -> dashboards_out/<uid>.json
dashboards:
    @mkdir -p dashboards_out
    docker run --rm -v "$PWD":/work {{IMAGE}} render render-dashboards.jsonnet -m dashboards_out

# render the Prometheus alert rules -> prometheus_alerts.yaml (JSON is valid YAML)
alerts:
    docker run --rm -v "$PWD":/work {{IMAGE}} render render-alerts.jsonnet > prometheus_alerts.yaml
    @echo "wrote prometheus_alerts.yaml"

# render the Prometheus recording rules -> prometheus_rules.yaml
rules:
    docker run --rm -v "$PWD":/work {{IMAGE}} render render-rules.jsonnet > prometheus_rules.yaml
    @echo "wrote prometheus_rules.yaml"

# render everything (dashboards + alerts + rules)
build: dashboards alerts rules

# remove rendered output
clean:
    rm -rf dashboards_out prometheus_alerts.yaml prometheus_rules.yaml
